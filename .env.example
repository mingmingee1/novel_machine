# Node.js 24+. Copy to .env; keys stay on the server.
NOVEL_HOST=127.0.0.1
NOVEL_PORT=4317
NOVEL_DATA_DIR=./data
# Required to listen on a private network. Set a long random password.
# NOVEL_ACCESS_TOKEN=
# Optional HTTPS address from Tailscale Serve; keep NOVEL_HOST=127.0.0.1.
# NOVEL_PUBLIC_ORIGIN=https://your-pc.your-tailnet.ts.net:8443
# API connections are optional. No automatic provider switching.
# NOVEL_OPENAI_API_KEY=
# NOVEL_GEMINI_API_KEY=
# Optional executable paths; never include shell arguments here.
# NOVEL_CODEX_PATH=codex
# NOVEL_GEMINI_PATH=gemini
